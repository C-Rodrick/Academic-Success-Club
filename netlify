export default async (req) => {
  const body = await req.text();

  const scriptResponse = await fetch(
    "https://script.google.com/macros/s/AKfycbzcs0bovw0iZKlnkZJg_f6tVYtOlmSAWuNWGhxBCGYxqe-tnVr6azEPl2l_iIarj2VAKA/exec",
    {
      method: "POST",
      body: body,
      headers: { "Content-Type": "application/json" },
      redirect: "follow" // this is the key part — fetch() follows redirects automatically
    }
  );

  const result = await scriptResponse.text();

  return new Response(result, {
    status: 200,
    headers: { "Content-Type": "text/plain" }
  });
};

export const config = { path: "/forward-to-sheet" };
